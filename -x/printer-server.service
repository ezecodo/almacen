[Unit]
Description=Servidor de impresion de tickets (MQTT -> ESC/POS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/printer-server
EnvironmentFile=-/home/pi/printer-server/.env
ExecStart=/home/pi/printer-server/venv/bin/python3 /home/pi/printer-server/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
