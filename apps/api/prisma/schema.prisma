generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                     Int                   @id @default(autoincrement())
  nombre                 String
  placeId                String?
  reviewObjetivoTasa     Int?
  reviewsCheckActivo     Boolean               @default(false)
  retiros                Retiro[]
  reviews                ReviewSnapshot[]
  propinas               PropinaDia[]
  menu                   MenuItem[]
  menuCats               MenuCategoria[]
  floorPlans             FloorPlan[]
  comandas               Comanda[]
  mermas                 Merma[]
  grupoMenus             GrupoMenuTemplate[]
  grupoAgendados         GrupoAgendado[]
  empleados              Empleado[]
  turnos                 Turno[]
  invCategorias          InventarioCategoria[]
  invProductos           InventarioProducto[]
  invConteos             InventarioConteo[]
  invProducciones        InventarioProduccion[]
  reservaConfig          ReservaConfig?
  reservas               Reserva[]
  turnosEmpleados        TurnoEmpleado[]
  turnoTipos             TurnoTipo[]
  staffingConfig         StaffingConfig?
  necesidadesDia         StaffingNecesidadDia[]
  necesidadesFecha       StaffingNecesidadFecha[]
  wikiArticulos          WikiArticulo[]
  checklistSectores      ChecklistSector[]
  checklistEjecuciones   ChecklistEjecucion[]
  ticketConfig           TicketConfig?
  impresoras             Impresora[]
  facturas               Factura[]
  agotados               ItemAgotado[]
  accesosRapidos         AccesoRapido[]
  rectificativas         Rectificativa[]
  accesoRapidoAuto       Boolean               @default(true) // completar los accesos rápidos con lo más vendido
  accesoRapidoPropia     Boolean? // true = lista propia; false = la del grupo; null = nunca tocado (propia si tiene filas)
  gastos                 Gasto[]
  gastosHabituales       GastoHabitual[]
  // Código de la Raspberry Pi de impresión vinculada a este restaurante (ej. "OIDO-7F3A2C",
  // sale del número de serie de la Pi). null = sin Pi → las comandas no se imprimen.
  piCodigo               String?               @unique
  // Secreto con el que esa Pi firma su latido (ver routes/red.ts). Se genera al vincularla.
  piSecreto                String?
  // Operar la sala (mesas, comandas, cobros) solo desde la red del local. Apagado por defecto:
  // se enciende desde /admin/red cuando el local ya tiene su red aprendida.
  restringirPorRed       Boolean               @default(false)
  redes                  RedLocal[]
  createdAt              DateTime              @default(now())
}

// Redes desde las que se puede operar la sala de un restaurante: la dirección pública con la
// que el local sale a internet. La aprende sola del latido de la Pi; no se cargan a mano.
model RedLocal {
  id             Int        @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ip             String
  origen         String // 'pi' | 'manual'
  autorizadaPor  String?
  vistaAt        DateTime   @default(now()) // último latido desde esa red, o cuándo se autorizó
  caducaAt       DateTime? // solo las manuales
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, ip])
}

// ── Wiki ──────────────────────────────────────────────────────────────────────
// Base de conocimiento por restaurante: speeches, protocolos, conceptos.
// Categorías globales (compartidas por la cadena) + artículos con scope
// global (restaurantId = null) o específico de un restaurante.

model WikiCategoria {
  id        Int            @id @default(autoincrement())
  nombre    String
  icono     String         @default("")
  orden     Int            @default(0)
  articulos WikiArticulo[]
  createdAt DateTime       @default(now())
}

model WikiArticulo {
  id           Int           @id @default(autoincrement())
  categoriaId  Int
  categoria    WikiCategoria @relation(fields: [categoriaId], references: [id])
  restaurantId Int?          // null = global (toda la cadena)
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id])
  titulo       String
  guiones      Json          @default("{}") // { en?, fr?, de? } — guiones por idioma (lo que lee el TTS)
  notas        String        @default("") // notas/contexto en español para el camarero
  orden        Int           @default(0)
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ── Checklists ──────────────────────────────────────────────────────────────────
// Cada restaurante define sus sectores (Barra 1, Sala 2, Paso…). Cada sector tiene
// ítems de apertura y de cierre. Cada vez que el personal completa uno se registra
// una ejecución con snapshot inmutable de lo marcado (accountability).

model ChecklistSector {
  id           Int                  @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  nombre       String               // "Barra 1", "Sala 2", "Paso"
  orden        Int                  @default(0)
  items        ChecklistItem[]
  ejecuciones  ChecklistEjecucion[]
  createdAt    DateTime             @default(now())
}

model ChecklistItem {
  id        Int             @id @default(autoincrement())
  sectorId  Int
  sector    ChecklistSector @relation(fields: [sectorId], references: [id])
  momento   String          // 'apertura' | 'cierre'
  texto     String
  orden     Int             @default(0)
  createdAt DateTime        @default(now())
}

model ChecklistEjecucion {
  id            Int             @id @default(autoincrement())
  sectorId      Int
  sector        ChecklistSector @relation(fields: [sectorId], references: [id])
  restaurantId  Int
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  momento       String          // 'apertura' | 'cierre'
  completadoPor String
  itemsMarcados Json            // snapshot: [{ texto: string, marcado: boolean }]
  fecha         DateTime        @default(now())
}

model Turno {
  id              Int        @id @default(autoincrement())
  restaurantId    Int
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  estado          String     @default("abierto") // 'abierto' | 'cerrado'
  encargadoNombre String?
  aperturaAt      DateTime   @default(now())
  cierreAt        DateTime?
  // Totales calculados al cerrar
  totalEfectivo   Float?
  totalTarjeta    Float?
  totalVentas     Float?
  totalMermas     Float?
  totalPropinas   Float?
  totalInvitaciones Float?  // valor de items marcados como invitación de la casa (no suman a ventas)
  totalGastos     Float?     // gastos pagados en efectivo durante el turno (salieron de la caja)
  totalRectificado Float?    // suma de las diferencias de las rectificativas del turno (negativo = se devolvió dinero)
  numComandas     Int?
  propina         PropinaDia?
  createdAt       DateTime   @default(now())
}

model Merma {
  id             Int        @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  mesaNumero     Int?
  planNombre     String?
  comandaId      Int?
  comanda        Comanda?   @relation(fields: [comandaId], references: [id])
  itemNombre     String
  cantidad       Int        @default(1)
  precio         Float      @default(0)
  itemNivel      Int?
  itemRonda      Int        @default(1)
  camareroNombre String?
  motivo         String     // 'no_servido' | 'queja_cliente' | 'otro'
  descripcion    String?
  createdAt      DateTime   @default(now())
}

model ReviewSnapshot {
  id              Int        @id @default(autoincrement())
  restaurantId    Int
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  total           Int
  rating          Float
  reviewsData     Json?      // hasta 5 reviews más recientes tal cual las devuelve Google (rating, texto, autor, time)
  negativasNuevas Json?      // subset de reviewsData nuevas desde el snapshot anterior con rating <= 3
  posibleOculta   Boolean    @default(false) // el total subió más de lo identificable en detalle (>5 reviews nuevas entre chequeos)
  fecha           DateTime   @default(now())
}

model Empleado {
  id               Int              @id @default(autoincrement())
  nombre           String
  tipo             String           @default("cocina")
  pin              String?          @unique
  telefono         String?
  email            String?
  rol              String?          // cocina: 'friegaplatos'|'cocinero'|'produccion' / sala: 'camarero'|'encargado'
  puedeEncargado   Boolean          @default(false) // camarero que puede cubrir turno de encargado (concepto de planning)
  accesoEncargadoApp Boolean        @default(false) // superpoder: desbloquea el modo encargado 💼 en la app de sala (independiente del planning)
  puedeJefeCocina  Boolean          @default(false) // cocinero que puede cubrir turno de jefe de cocina
  excluirPlanning  Boolean          @default(false) // no incluir en auto-planning
  restaurantId     Int?             // restaurante habitual (null = rotativo)
  restaurant       Restaurant?      @relation(fields: [restaurantId], references: [id])
  retiros          Retiro[]
  turnos           PropinaTurno[]
  activo           Boolean          @default(true)
  horasSemanales      Int              @default(40)
  diasLibresFijos     Int[]            @default([]) // días fijos de libranza: 0=Lun … 6=Dom
  faseLibreRotacion   Int              @default(0)  // 0-3: fase actual en rotación de días libres
  turnosAsignados     TurnoEmpleado[]
  createdAt        DateTime         @default(now())
}

model PropinaDia {
  id           Int            @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  turnoId      Int?           @unique
  turno        Turno?         @relation(fields: [turnoId], references: [id])
  fecha        DateTime
  efectivo     Float          @default(0)
  tarjeta      Float          @default(0)
  total        Float
  turnos       PropinaTurno[]
  createdAt    DateTime       @default(now())
}

model PropinaTurno {
  id           Int        @id @default(autoincrement())
  propinaDiaId Int
  propinaDia   PropinaDia @relation(fields: [propinaDiaId], references: [id])
  empleadoId   Int
  empleado     Empleado   @relation(fields: [empleadoId], references: [id])
  horas        Float      @default(8)
  propina      Float
}

model Retiro {
  id             Int          @id @default(autoincrement())
  createdAt      DateTime     @default(now())
  empleadoId     Int?         // null si el empleado fue eliminado
  empleadoNombre String?      // nombre guardado al crear (persiste aunque se elimine el empleado)
  restaurantId   Int
  empleado       Empleado?    @relation(fields: [empleadoId], references: [id])
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id])
  items          RetiroItem[]
  confirmadoAt   DateTime?
  confirmadoPor  String?
}

model RetiroItem {
  id       Int    @id @default(autoincrement())
  retiroId Int
  retiro   Retiro @relation(fields: [retiroId], references: [id])
  barcode  String
  nombre   String
  cantidad Float
  unidad   String
}

model MenuCategoria {
  id           Int         @id @default(autoincrement())
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  grupo        String     @default("")
  nombre       String
  icono        String     @default("")
  orden        Int        @default(0)
  ordenAlfabetico Boolean @default(false) // mostrar los items A→Z en vez del orden manual (carta física)
  nombreEnTicket  Boolean @default(false) // en la comanda de cocina, un nivel solo con platos de aquí sale con este nombre (ej. POSTRES) en vez de PRIMEROS, SEGUNDOS…
  asistente    String?    // asistente de sala conectado ('vinos'); sus subcategorías lo heredan. null = nunca tocado, '' = ninguno
  parentId     Int?       // subcategoría: id de la categoría contenedora (1 solo nivel)
  parent       MenuCategoria?  @relation("SubCategorias", fields: [parentId], references: [id])
  children     MenuCategoria[] @relation("SubCategorias")
  createdAt    DateTime   @default(now())
}

model MenuItem {
  id           Int         @id @default(autoincrement())
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  categoria    String
  nombre       String
  descripcion  String     @default("")
  ficha        String     @default("") // texto largo de estudio (uvas, crianza, notas de cata…): NO sale en el picker de sala, ni en comandas ni en tickets
  precio       Float
  activo       Boolean    @default(true)
  autoPorPax   Boolean    @default(false)
  ocultoEnCarta Boolean   @default(false) // no se muestra en el picker del camarero (sigue activo: se cobra y se auto-añade)
  orden        Int        @default(0)
  alergenos     Alergeno[]              // catálogo editable (tabla Alergeno), ya no bitmask
  receta        Receta?                 // escandallo (ingredientes y cantidades) → coste del plato
  alergenosNota String    @default("")  // matices que no entran en una casilla: "gluten in the sauce", trazas…
  // Combinados: destilado marcado combinable + pool global de mixers
  combinable      Boolean @default(false)  // se puede pedir combinado (destilados)
  precioCombinado Float?                   // precio del combinado, refresco incluido (null = usar precio)
  esMixer         Boolean @default(false)  // sirve de mezcla (refrescos, tónicas…)
  suplementoMixer Float   @default(0)      // extra si el mixer es premium (Red Bull +1.50)
  agotadoEn    ItemAgotado[]
  accesoRapidoEn AccesoRapido[]
  maridajesComoPlato Maridaje[] @relation("MaridajePlato")
  maridajesComoVino  Maridaje[] @relation("MaridajeVino")
  perfilVino         PerfilVino?
  createdAt    DateTime   @default(now())
}

// Qué tal va cada vino con cada plato (botón 🍷 de la sala). Lo calcula Claude desde las fichas
// (routes/maridajes.ts → "Recalcular con IA" en /admin/maridajes) y se puede corregir a mano:
// una pareja editada a mano no la pisa el siguiente recálculo. Común a todos los restaurantes.
model Maridaje {
  id        Int      @id @default(autoincrement())
  platoId   Int
  plato     MenuItem @relation("MaridajePlato", fields: [platoId], references: [id], onDelete: Cascade)
  vinoId    Int
  vino      MenuItem @relation("MaridajeVino", fields: [vinoId], references: [id], onDelete: Cascade)
  puntos    Int      // 0 = no pega … 10 = perfecto
  motivo    String   @default("") // para el camarero, en español (solo los mejores de cada color)
  motivoEn  String   @default("") // lo mismo para decírselo al cliente
  oculto    Boolean  @default(false) // "este no": no se recomienda nunca con este plato
  editado   Boolean  @default(false) // tocado a mano: el recálculo no lo cambia
  updatedAt DateTime @updatedAt

  @@unique([platoId, vinoId])
}

// Cómo es cada vino, del 1 al 5, para cuando el cliente pide por gusto ("full-bodied", "seco"…)
// antes de pedir la comida. Lo saca Claude de la ficha en el mismo recálculo; editable a mano.
model PerfilVino {
  id        Int      @id @default(autoincrement())
  vinoId    Int      @unique
  vino      MenuItem @relation(fields: [vinoId], references: [id], onDelete: Cascade)
  cuerpo    Int      // 1 ligero … 5 con mucho cuerpo
  dulzor    Int      // 1 seco … 5 dulce
  fruta     Int      // 1 poca … 5 muy afrutado
  madera    Int      // 1 sin barrica … 5 mucha crianza en madera
  frescor   Int      // 1 suave, poca acidez … 5 muy fresco y ácido
  aromatico Int      // 1 neutro … 5 muy aromático
  color     String?  // tinto|blanco|rosado|espumoso — lo dice Claude cuando no sale del nombre de la categoría
  editado   Boolean  @default(false) // tocado a mano: el recálculo no lo cambia
  updatedAt DateTime @updatedAt
}

// Plato que se acabó durante el servicio en un local (la carta es común: no se toca MenuItem.activo).
// Lo marca el encargado desde el panel 💼; sale un ticket "ALTO" en todas las impresoras del local
// y en la sala el plato se ve apagado. Se borra al reponerlo o al cerrar el turno.
model ItemAgotado {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  marcadoPor   String
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, menuItemId])
}

// Accesos rápidos de la carta en sala (arriba de COMIDA / BEBIDAS al abrir una mesa).
// restaurantId null = lista del grupo; X = lista propia de un local (solo se usa si
// Restaurant.accesoRapidoPropia). Si Restaurant.accesoRapidoAuto, los huecos se llenan con las
// bebidas más vendidas del local (routes/accesos-rapidos.ts).
model AccesoRapido {
  id           Int         @id @default(autoincrement())
  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orden        Int        @default(0)

  @@unique([restaurantId, menuItemId])
}

// Escandallo de un plato: qué ingredientes (productos del catálogo de Inventario) lleva y cuánto.
// El coste se calcula al vuelo con el precioCoste vigente de cada producto — no se guarda.
model Receta {
  id         Int           @id @default(autoincrement())
  menuItemId Int           @unique
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  raciones   Float         @default(1) // raciones que salen de las cantidades indicadas
  lineas     RecetaLinea[]
  updatedAt  DateTime      @updatedAt
}

model RecetaLinea {
  id         Int                @id @default(autoincrement())
  recetaId   Int
  receta     Receta             @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  productoId Int
  producto   InventarioProducto @relation(fields: [productoId], references: [id])
  cantidad   Float              // en la unidad base del producto (g / ml / ud)
  orden      Int                @default(0)
}

// Catálogo de alérgenos, editable desde /admin/alergenos (añadir/quitar/renombrar).
// Común a todos los restaurantes. Arranca con los 14 del Reglamento UE 1169/2011.
model Alergeno {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  nombreEn  String     @default("") // en inglés: lo que el camarero le dice al cliente
  icono     String     @default("")
  orden     Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
}

model FloorPlan {
  id           Int             @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])
  nombre       String
  mesas        Mesa[]
  rutas        ImpresionRuta[]
  createdAt    DateTime        @default(now())
}

model Mesa {
  id          Int       @id @default(autoincrement())
  floorPlanId Int
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  numero      Int
  tipo        String    // 'round' | 'square' | 'rectangular' | 'barra' | 'silla_alta'
  x           Float
  y           Float
  capacidad   Int
  rotacion    Int       @default(0) // 0 | 90 | 180 | 270
  ancho       Int?      // ancho px personalizado (barra)
  alto        Int?      // alto px personalizado (barra)
  // Mesa que se puede separar en dos (ej. la 2 son la 2 y la 3 juntas): la otra mitad es otra fila
  // con parteDeId = esta, escondida mientras están juntas. Su x/y no se usan: las dos mitades se
  // dibujan partiendo el sitio de la mesa entera (lib de salon.ts).
  parteDeId   Int?      @unique
  parteDe     Mesa?     @relation("MesaMitad", fields: [parteDeId], references: [id], onDelete: Cascade)
  mitad       Mesa?     @relation("MesaMitad")
  separada    Boolean   @default(false) // solo en la mesa entera: ahora mismo está partida en dos
  comandas    Comanda[]
  reservas    Reserva[]
  createdAt   DateTime  @default(now())
}

model Comanda {
  id           Int           @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  mesaId       Int?
  mesa         Mesa?         @relation(fields: [mesaId], references: [id])
  pax            Int
  estado         String        @default("abierta") // 'abierta' | 'enviada' | 'facturada' | 'liberada' | 'cerrada'
  metodoPago     String?       // 'cash' | 'tarjeta' | 'mixto' | null
  propina        Float         @default(0)
  pagoEfectivo   Float?        // con metodoPago 'mixto': parte de la cuenta pagada en efectivo (el resto, con tarjeta)
  rectificaciones Json?        // correcciones de una mesa ya cobrada: [{ tipo: 'pago'|'deshacer', por, at, motivo?, antes, despues? }] — ver comandas.ts
  cobroDeshecho   Json?        // foto de la cuenta cobrada mientras la mesa espera volver a cobrarse tras "deshacer el cobro"; al recobrar, si el importe cambió, nace una Rectificativa
  rectificativas  Rectificativa[]
  division       Json?         // pagar por separado: { quedan?, pagos: [{ id, importe, propina, metodo, consumo?, at, por? }] } — ver pago.ts
  camareroNombre String?
  cuentaDesactualizada Boolean @default(false) // los items cambiaron tras imprimir la cuenta → reimprimir antes de cobrar
  notaMesa             String    @default("") // nota del camarero para cocina sobre toda la mesa: sale como COM: al final de los tickets
  noComparten          Boolean   @default(false) // la mesa no comparte: cocina emplata individual (franja NO COMPARTEN en sus tickets)
  alergenoIds          Int[]     @default([])    // alguien de la mesa es alérgico (ids de Alergeno): la sala marca los platos que chocan y sale como COM: ALÉRGICO: … en los tickets
  enviadaAt      DateTime?     // primera vez que la comanda se envió a cocina ("hora de comandada")
  items        ComandaItem[]
  mermas       Merma[]
  reserva      Reserva?
  createdAt    DateTime      @default(now())
  closedAt     DateTime?
}

// Rectificativa por diferencias de una mesa ya cobrada: se deshizo el cobro, se cambió la cuenta
// (se quitó un plato, merma, invitación…) y se volvió a cobrar por otro importe. La crea
// PATCH /comandas/:id/cerrar. Los campos fiscales (serie, número, huella…) quedan vacíos hasta que
// se defina con la gestoría si la app emite las facturas (docs/verifactu.md): entonces cada fila es
// una rectificativa R5 por diferencias de la factura original.
model Rectificativa {
  id              Int        @id @default(autoincrement())
  restaurantId    Int
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  comandaId       Int?
  comanda         Comanda?   @relation(fields: [comandaId], references: [id], onDelete: SetNull)
  turnoId         Int?                 // turno abierto al recobrar (para los totales del cierre)
  mesaNumero      String?
  por             String               // quién volvió a cobrar
  deshizoPor      String?              // quién deshizo el cobro
  motivo          String?              // 'error_cobro' | 'cliente_reclamo' | 'otro'
  importeOriginal Float
  importeNuevo    Float
  diferencia      Float                // nuevo − original: negativo = se devolvió dinero al cliente
  devolucion      String?              // por dónde se devolvió/cobró la diferencia: método del cobro original ('cash' | 'tarjeta' | 'mixto')
  lineas          Json                 // [{ nombre, precio, antes, despues, importe }] solo lo que cambió
  original        Json                 // la cuenta tal como se cobró: { items, total, metodoPago, pagoEfectivo, propina, cobradaAt }
  // Fiscales (Veri*factu): vacíos por ahora
  serie           String?
  numero          Int?
  facturaOriginal String?
  huella          String?
  emitidaAt       DateTime?
  createdAt       DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model ComandaItem {
  id         Int     @id @default(autoincrement())
  comandaId  Int
  comanda    Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  nombre     String
  precio     Float
  cantidad   Int     @default(1)
  nota       String  @default("")
  nivel      Int?
  ronda      Int     @default(0) // 0=pendiente, 1=comanda original, 2+=marcha pasa
  tipo         String  @default("cocina") // 'cocina' | 'barra'
  autoGenerado Boolean @default(false)   // true = auto-añadido al abrir mesa (no va a cocina/barra)
  invitacion   Boolean @default(false)   // 🎁 invitación de la casa: visible en cuenta a 0 €, no suma a ventas
  invitadoPor  String?                   // quién la marcó
  invitacionMotivo String?               // por qué se invitó (opcional) (accountability)
}

model Producto {
  id        Int      @id @default(autoincrement())
  barcode   String   @unique
  nombre    String
  unidad    String   @default("ud")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventarioCategoria {
  id             Int                  @id @default(autoincrement())
  nombre              String
  orden               Int                  @default(0)
  personalProduccion  String?              // null = no es producción | 'sala' | 'cocina'
  restaurantId        Int?
  restaurant     Restaurant?          @relation(fields: [restaurantId], references: [id])
  productos      InventarioProducto[]
}

model InventarioProducto {
  id             Int                    @id @default(autoincrement())
  nombre         String
  unidad         String                 @default("ud")
  stockMinimo    Float                  @default(0)
  precioCoste    Float?
  precioVenta    Float?
  // Escandallos: cómo se mide el producto dentro de una receta. null = se deduce de `unidad`
  // (kg → 1000 g, l → 1000 ml, botella → 750 ml, caja/ud → 1 ud).
  unidadBase     String?                // 'g' | 'ml' | 'ud'
  contenido      Float?                 // unidades base por unidad de compra (botella de 700 ml → 700)
  mermaPct       Float                  @default(0) // % que se pierde al limpiar/cocinar (0-95)
  recetaLineas   RecetaLinea[]
  orden          Int                    @default(0)
  activo         Boolean                @default(true)
  categoriaId    Int
  categoria    InventarioCategoria    @relation(fields: [categoriaId], references: [id])
  restaurantId Int?
  restaurant   Restaurant?            @relation(fields: [restaurantId], references: [id])
  items        InventarioConteoItem[]
  producciones InventarioProduccion[]
}

model InventarioConteo {
  id           Int                    @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id])
  fecha        DateTime               @default(now())
  creadoPor    String?
  notas        String?
  cerrado      Boolean                @default(false)
  items        InventarioConteoItem[]
  createdAt    DateTime               @default(now())
}

model InventarioProduccion {
  id           Int                @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id])
  productoId   Int
  producto     InventarioProducto @relation(fields: [productoId], references: [id])
  cantidad     Float
  unidad       String
  creadoPor    String?
  notas        String?
  fecha        DateTime           @default(now())
  createdAt    DateTime           @default(now())
}

model InventarioConteoItem {
  id         Int                @id @default(autoincrement())
  conteoId   Int
  conteo     InventarioConteo   @relation(fields: [conteoId], references: [id], onDelete: Cascade)
  productoId Int
  producto   InventarioProducto @relation(fields: [productoId], references: [id])
  cantidad   Float

  @@unique([conteoId, productoId])
}

model ReservaConfig {
  id             Int              @id @default(autoincrement())
  restaurantId   Int              @unique
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  slug           String           @unique
  activo         Boolean          @default(true)
  maxPaxPorSlot  Int              @default(20)
  duracionMin    Int              @default(90)
  diasAntelacion Int              @default(30)
  horarios       ReservaHorario[]
  reservas       Reserva[]
  createdAt      DateTime         @default(now())
}

model ReservaHorario {
  id           Int           @id @default(autoincrement())
  configId     Int
  config       ReservaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  nombre       String        @default("Noche")
  diasSemana   Json
  horaInicio   String
  horaFin      String
  intervaloMin Int           @default(15)
  maxPax       Int           @default(20)
  activo       Boolean       @default(true)
}

model Reserva {
  id           Int           @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  configId     Int?          // null en un walk-in (el local puede no tener reservas online)
  config       ReservaConfig? @relation(fields: [configId], references: [id])
  fecha        DateTime
  hora         String
  pax          Int
  nombre       String?       // null solo en un walk-in: no deja nombre ni teléfono
  telefono     String?
  email        String?
  notas        String?
  estado       String        @default("confirmada") // 'confirmada' | 'sentada' | 'cancelada' | 'no_show'
  origen       String        @default("web") // 'web' | 'manual' | 'walkin' (lo sentó el encargado al llegar, sin reserva)
  createdAt    DateTime      @default(now())

  // Asignación de mesa (informativa, no bloquea el mapa) + activación al llegar el cliente:
  // "sentar" crea la Comanda en esa mesa con el pax de la reserva y linkea comandaId.
  mesaId       Int?
  mesa         Mesa?     @relation(fields: [mesaId], references: [id])
  comandaId    Int?      @unique
  comanda      Comanda?  @relation(fields: [comandaId], references: [id])
  sentadaAt    DateTime?

  // Pool de reservas entre restaurantes: cuando el restaurante que la recibió no tiene espacio,
  // la ofrece al resto del grupo (ver roadmap en CLAUDE.md, punto 6)
  enPool               Boolean   @default(false)
  poolMotivo           String?
  poolDesde            DateTime?
  poolGestionandoPor   String? // lock blando: nombre del encargado que está llamando al cliente
  poolGestionandoDesde DateTime?
  restaurantIdOrigen   Int? // restaurante donde entró originalmente (se conserva aunque ya la haya tomado otro)
}

// Plantillas de menú cerrado para grupos
// niveles: GrupoMenuNivel[] almacenado como JSON
// GrupoMenuNivel = { nivel: number, plato: string, vegetariano?: string, sinCerdo?: string, sinGluten?: string, esPostre?: boolean }
model GrupoMenuTemplate {
  id             Int              @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  nombre         String           // "Estándar" | "Premium" | "Deluxe"
  precio         Float            // precio por persona
  paxPorRacion   Int              @default(3) // tapeo compartido: 1 ración de cada plato cada X pax (sugerencia de cantidades)
  niveles        Json             // GrupoMenuNivel[]
  activo         Boolean          @default(true)
  agendados      GrupoAgendado[]
  createdAt      DateTime         @default(now())
}

// Grupo programado para una fecha concreta
// restricciones: { normales, vegetarianos, sinCerdo, sinGluten }
model GrupoAgendado {
  id            Int               @id @default(autoincrement())
  restaurantId  Int
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id])
  templateId    Int
  template      GrupoMenuTemplate @relation(fields: [templateId], references: [id])
  fecha         DateTime          // fecha del evento (solo se usa la parte de fecha)
  pax           Int
  restricciones Json              // GrupoMenuRestricciones
  notas         String?
  estado        String            @default("pendiente") // 'pendiente' | 'asignado' | 'cancelado'
  comandaId     Int?              @unique
  createdAt     DateTime          @default(now())
}

model TurnoTipo {
  id                   Int             @id @default(autoincrement())
  restaurantId         Int?            // null = global (compartido entre todos los restaurantes)
  restaurant           Restaurant?     @relation(fields: [restaurantId], references: [id])
  nombre               String
  horaInicio           String
  horaFin              String
  horas                Float
  color                String          @default("#6366f1")
  tipoEmpleado         String?         // 'cocina' | 'sala' | null (= ambos)
  rolEmpleado          String?         // rol específico: 'jefe_cocina' | 'cocinero' | etc. | null (= todos los roles)
  excluirAutoPlanning  Boolean         @default(false)
  activo               Boolean         @default(true)
  turnos               TurnoEmpleado[]
  createdAt            DateTime        @default(now())
}

model TurnoEmpleado {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  empleadoId   Int
  empleado     Empleado   @relation(fields: [empleadoId], references: [id])
  tipoId       Int?
  tipo         TurnoTipo? @relation(fields: [tipoId], references: [id])
  fecha        DateTime
  horaInicio   String
  horaFin      String
  estado       String     @default("planificado") // 'planificado' | 'confirmado' | 'ausente'
  esExtra      Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, fecha])
}

model StaffingConfig {
  id              Int        @id @default(autoincrement())
  restaurantId    Int        @unique
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  ratioSalaXPax   Int        @default(20)
  ratioCocinaXPax Int        @default(30)
  createdAt       DateTime   @default(now())
}

// Plantilla base: personal estándar por día de la semana
model StaffingNecesidadDia {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  diaSemana    Int        // 0=Lun 1=Mar 2=Mié 3=Jue 4=Vie 5=Sáb 6=Dom
  jefeCocina   Int        @default(0)
  cocineros    Int        @default(0)
  friegaplatos Int        @default(0)
  produccion   Int        @default(0)
  camareros    Int        @default(0)
  encargados   Int        @default(0)

  @@unique([restaurantId, diaSemana])
}

// Extras por fecha concreta (festivos, eventos, viernes especiales…)
model StaffingNecesidadFecha {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  fecha        DateTime   // fecha exacta (UTC 00:00)
  jefeCocina   Int        @default(0)
  cocineros    Int        @default(0)
  friegaplatos Int        @default(0)
  produccion   Int        @default(0)
  camareros    Int        @default(0)
  encargados   Int        @default(0)
  notas        String?

  @@unique([restaurantId, fecha])
}

// ── Tickets (impresión térmica 80mm) ─────────────────────────────────────────
// Datos de empresa (una sola fila, compartida por los 5 restaurantes) +
// datos específicos por local (nombre comercial, dirección, teléfono).

model EmpresaConfig {
  id          Int      @id @default(autoincrement())
  razonSocial String   @default("")
  nif         String?
  tasaIva     Float    @default(10)
  // Semáforo de escandallos: food cost % hasta el que un plato es verde / ámbar (por encima, rojo)
  foodCostVerde Float  @default(30)
  foodCostAmbar Float  @default(35)
  mensajePie  String?  // pie por defecto del ticket de cobro, ej "Servicio no incluido"
  updatedAt   DateTime @updatedAt
}

model TicketConfig {
  id                 Int        @id @default(autoincrement())
  restaurantId       Int        @unique
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])
  nombreComercial    String     // nombre del local en el ticket, ej "Sensi Tapas - Gòtic"
  direccion          String?
  telefono           String?
  mensajePieOverride String?    // null = usa el de EmpresaConfig
  updatedAt          DateTime   @updatedAt
}

// Impresora física ESC/POS (IP en la red del local). Un restaurante puede tener
// varias (Cocina, Barra, Arriba…) — el nombre es libre, lo define el encargado.
model Impresora {
  id           Int             @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])
  nombre       String          // "Cocina", "Barra", "Arriba"…
  ip           String
  // Dirección física (MAC). Si la Pi la encuentra en la red con otra IP, la IP se corrige sola.
  // null = todavía no se sabe (se completa cuando la Pi detecta una impresora en esa IP).
  mac          String?
  rutas        ImpresionRuta[]
  createdAt    DateTime        @default(now())
}

// Ruta de impresión: qué tipo de ticket, comandado desde qué sala (FloorPlan),
// sale por cuál impresora y cuántas copias. Permite que un mismo ticket (ej. comida)
// salga duplicado en varias impresoras (jefe de cocina + camarero de pase + refuerzo arriba).
model ImpresionRuta {
  id          Int       @id @default(autoincrement())
  floorPlanId Int
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  tipoTicket  String    // 'cocina' | 'barra' | 'cobro'
  impresoraId Int
  impresora   Impresora @relation(fields: [impresoraId], references: [id], onDelete: Cascade)
  copias      Int       @default(1)
}

// ── Facturas de proveedor ─────────────────────────────────────────────────────
// Catálogo de proveedores: común a todos los restaurantes, se gestiona en /admin/facturas.
model Proveedor {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  activo    Boolean   @default(true) // false = quitado del catálogo pero con facturas históricas
  facturas  Factura[]
  createdAt DateTime  @default(now())
}

// El encargado fotografía la factura al recibir el pedido (panel 💼 de /sala) y
// llega a la bandeja de /admin/facturas. Las páginas (JPEG) viven en disco
// (uploads/facturas/<id>/<n>.jpg), no en la DB — acá solo va la metadata.
model Factura {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  proveedor    String     // nombre (snapshot; se actualiza si se renombra el proveedor del catálogo)
  proveedorId  Int?       // null = "Otro": escrito a mano por el encargado, aún sin catalogar
  proveedorRef Proveedor? @relation(fields: [proveedorId], references: [id])
  numero       String?    // nº de factura/albarán tal como figura en el papel
  nota         String?    // "faltaron 2 botellas"…
  subidoPor    String
  subidoPorId  Int?
  paginas      Int        @default(0)
  estado       String     @default("subiendo") // 'subiendo' (aún cargando páginas) | 'pendiente' | 'revisada'
  revisadaAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// ── Gastos del día (libreta del encargado) ───────────────────────────────────────────────────
// Lo que se compra o recibe en el turno sin pedido formal: pan, hielo, frutería, velas…
// GastoHabitual = botones que se cargan en /admin/gastos (globales o de un local, como la carta); un habitual
// puede tener tipos (HIELO → PILE, CUBO) o no (PAN). Gasto = cada apunte del encargado desde 💼.
model GastoHabitual {
  id      Int         @id @default(autoincrement())
  restaurantId Int?                       // null = global (todos los locales), X = solo ese local (como la carta)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  nombre  String
  icono   String      @default("")
  unidad  String      @default("")        // "barras", "sacos"… (solo para mostrar)
  precio  Float?                          // precio por unidad si no tiene tipos (opcional)
  pago    String      @default("efectivo") // forma de pago habitual: 'efectivo' | 'cuenta'
  orden   Int         @default(0)
  activo  Boolean     @default(true)
  tipos   GastoTipo[]
  gastos  Gasto[]
}

model GastoTipo {
  id        Int           @id @default(autoincrement())
  habitualId Int
  habitual  GastoHabitual @relation(fields: [habitualId], references: [id], onDelete: Cascade)
  nombre    String                    // PILE, CUBO
  precio    Float?                    // precio por unidad (opcional)
  orden     Int           @default(0)
}

model Gasto {
  id           Int            @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  habitualId   Int?                       // null = gasto libre ("VELAS")
  habitual     GastoHabitual? @relation(fields: [habitualId], references: [id], onDelete: SetNull)
  nombre       String                     // copia del nombre al apuntarlo (o el texto libre)
  lineas       Json                       // [{ tipo: string | null, cantidad: number }]
  importe      Float?                     // lo pagado; null = a cuenta sin precio conocido
  pago         String                     // 'efectivo' | 'cuenta'
  pagadoAt     DateTime?                  // a cuenta: cuándo se saldó
  pagadoPor    String?
  pagadoCon    String?                    // 'efectivo' (sale de la caja de ese turno) | 'otro' (transferencia, tarjeta…)
  creadoPor    String
  createdAt    DateTime       @default(now())

  @@index([restaurantId, createdAt])
}
